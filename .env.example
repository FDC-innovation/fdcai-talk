# =============================================================================
# FDCAI — Environment Configuration Template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values marked REQUIRED
# 3. Run:            ./start.sh
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — using Groq (free, fast, no GPU needed)
# Get your key at: https://console.groq.com
# -----------------------------------------------------------------------------
# REQUIRED
GROQ_API_KEY=your_groq_api_key_here

# Do not change these — they point the OpenAI client to Groq
LLM_PROVIDER=openai
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Leave blank (not used when running Groq)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=


# -----------------------------------------------------------------------------
# Database (Postgres — runs inside Docker, no changes needed)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://avatar_user:change_this_password@postgres:5432/avatar_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=avatar_db
DATABASE_USER=avatar_user
DATABASE_PASSWORD=change_this_password


# -----------------------------------------------------------------------------
# Redis (runs inside Docker, no changes needed)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2


# -----------------------------------------------------------------------------
# Security keys
# REQUIRED — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24


# -----------------------------------------------------------------------------
# Avatar Engine
# musetalk = lip-sync AI (slow on CPU ~8-10 min, fast on GPU ~5s)
# simple   = static image + audio, instant, no lip-sync
# -----------------------------------------------------------------------------
AVATAR_ENGINE=musetalk
AVATAR_RESOLUTION=512
AVATAR_FPS=25
MUSETALK_PATH=/app/models/MuseTalk


# -----------------------------------------------------------------------------
# TTS — Text to Speech
# edge-tts = free Microsoft neural voices (no API key needed)
# chatterbox = voice cloning (requires GPU for best results)
# -----------------------------------------------------------------------------
TTS_PROVIDER=edge-tts
TTS_VOICE=default


# -----------------------------------------------------------------------------
# STT — Speech to Text (Whisper)
# tiny/base = fast, less accurate | small/medium = balanced | large-v3 = best
# Use base or small on CPU, large-v3-turbo on GPU
# -----------------------------------------------------------------------------
STT_PROVIDER=whisper
WHISPER_MODEL=base


# -----------------------------------------------------------------------------
# AWS S3 (optional — leave blank to use local file storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=


# -----------------------------------------------------------------------------
# Application settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp


# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10


# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=false
