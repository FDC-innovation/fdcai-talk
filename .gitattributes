# Force Unix line endings for all text files — prevents CRLF issues on Windows
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf
*.bash text eol=lf

# Python files
*.py text eol=lf

# Docker files
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Config / env files
*.env text eol=lf
*.env.* text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Web files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Markdown / docs
*.md text eol=lf

# Binary files — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.pkl binary
*.pth binary
*.zip binary
*.tar binary
*.gz binary
